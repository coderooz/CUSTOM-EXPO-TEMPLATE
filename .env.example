# Expo Template — Coderooz
# Copy this file to .env and fill in your values.
# Never commit .env files to version control.

# App
EXPO_PUBLIC_APP_NAME=expo-template-coderooz
EXPO_PUBLIC_APP_ENV=development

# API
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_API_TIMEOUT=10000

# Supabase / Backend (optional)
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Clerk (optional)
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Sentry (optional)
# EXPO_PUBLIC_SENTRY_DSN=

# OneSignal / Push Notifications (optional)
# EXPO_PUBLIC_ONESIGNAL_APP_ID=

# EXPO
EXPO_PUBLIC_DB_NAME=app.db

# EXPO
EXPO_PUBLIC_NOTIF_CHANNEL_ID=default

# EXPO
EXPO_PUBLIC_ICON_DEFAULT_FAMILY=Ionicons

# EXPO
EXPO_PUBLIC_APP_VERSION=1.0.0

# EXPO
EXPO_PUBLIC_AUTH_TOKEN_KEY=app_auth_token
EXPO_PUBLIC_AUTH_ENABLED=true
