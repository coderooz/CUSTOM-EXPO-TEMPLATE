{
  "name": "expo-template-coderooz",
  "version": "1.2.0",
  "description": "A production-ready Expo starter template with TypeScript, NativeWind, Drawer navigation, SQLite, Notifications and OTA updates.",
  "author": "Coderooz <coderooz.dev@gmail.com> (https://github.com/coderooz)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coderooz/expo-template-coderooz.git"
  },
  "bugs": {
    "url": "https://github.com/coderooz/expo-template-coderooz/issues"
  },
  "homepage": "https://coderooz.github.io/expo-template-coderooz/",
  "keywords": [
    "expo",
    "template",
    "create-expo-app",
    "react-native",
    "nativewind",
    "tailwind",
    "typescript",
    "starter",
    "coderooz"
  ],
  "main": "index",
  "files": [
    "App.tsx",
    "index.ts",
    "app.json",
    "template.json",
    "assets",
    "src",
    "global.css",
    "tsconfig.json",
    "babel.config.js",
    "metro.config.js",
    "tailwind.config.js",
    "postcss.config.js",
    "eslint.config.js",
    "AGENTS.md",
    "GOVERNANCE.md",
    "LLM.txt",
    "opencode.jsonc",
    "scripts/template-scripts.cjs",
    ".prettierrc",
    ".editorconfig",
    ".nvmrc",
    ".env.example",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/template-scripts.cjs test",
    "build": "node scripts/template-scripts.cjs build",
    "build:all": "node scripts/template-scripts.cjs build:all",
    "test:mono": "npm run test -w @coderooz/core -w @coderooz/feature-design-system -w @coderooz/feature-dynamic-pages",
    "build:mono": "npm run build -w @coderooz/core -w @coderooz/create-app -w @coderooz/cli && node scripts/bundle-assets.js",
    "build:all:mono": "npm run build:mono && node scripts/validate-features.js",
    "postinstall": "expo install --fix"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.8.6",
    "@react-navigation/drawer": "^7.7.4",
    "@react-navigation/native": "^7.1.21",
    "@react-navigation/native-stack": "^7.7.0",
    "@react-navigation/stack": "^7.6.7",
    "babel-preset-expo": "~54.0.10",
    "expo": "~54.0.36",
    "expo-application": "~7.0.8",
    "expo-auth-session": "~7.0.11",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-linking": "~8.0.12",
    "expo-navigation-bar": "~5.0.10",
    "expo-notifications": "~0.32.17",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-updates": "~29.0.19",
    "nativewind": "^4.2.1",
    "prettier-plugin-tailwindcss": "~0.5.14",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1",
    "tailwindcss": "^3.4.18",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "packages/*"
  ]
}
