{
  "name": "auth",
  "version": "1.0.4",
  "description": "Authentication service with token management, session persistence, and provider-agnostic design",
  "hooks": {
    "env": {
      "EXPO_PUBLIC_AUTH_TOKEN_KEY": "app_auth_token",
      "EXPO_PUBLIC_AUTH_ENABLED": "true"
    }
  },
  "dependencies": {
    "expo-secure-store": "~14.2.0",
    "expo-auth-session": "~7.0.9",
    "expo-web-browser": "~14.1.0",
    "expo-crypto": "~15.0.7"
  }
}
